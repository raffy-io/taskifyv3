package home

templ homepage() {
	<section class="p-5 md:px-24 flex flex-col items-center justify-center h-dvh">
		<h1
			class="capitalize text-8xl font-black mb-2 bg-linear-to-r from-blue-500 via-purple-500 to-pink-500 bg-clip-text text-transparent"
		>welcome</h1>
		<p class="text-gray-50 mb-4">Lorem ipsum dolor sit amet consectetur adipisicing elit. Ad perferendis ullam doloremque, nulla provident molestiae soluta suscipit mollitia quod, earum ipsum culpa? Culpa voluptas, quos explicabo corrupti nemo quod provident!</p>
		<a
			href="/task"
			class="flex items-center justify-center capitalize px-3 py-1 bg-red-500 text-red-50 hover:bg-red-400 hover:-translate-y-0.5 active:bg-red-500 active:translate-y-0 transition-all 3s rounded-sm"
		>get started</a>
	</section>
}
