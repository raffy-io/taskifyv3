package task

import (
	"fmt"
	"github.com/raffy-io/taskifyv3/internal/db"
	"strconv"
	"time"
)

func getGreeting(t time.Time) string {
	hour := t.Hour()
	switch {
	case hour >= 5 && hour < 12:
		return "Good morning"
	case hour >= 12 && hour < 18:
		return "Good afternoon"
	default:
		return "Good evening"
	}
}

templ tasksListPage(now time.Time, tasks []db.Task, username string, form *taskForm) {
	<section class="flex flex-col min-h-dvh mx-auto p-6 lg:px-24 text-gray-50">
		@tasksHeading(now, username, false)
		@tasksCounter(tasks, false)
		@createTaskForm(form, false)
		<div>
			<h3 class="capitalize font-thin text-2xl mb-6">ready when you are</h3>
		</div>
		@tasksList(tasks, false)
	</section>
}

templ tasksHeading(now time.Time, username string, isOOB bool) {
	<div
		id="task-heading"
		class="mb-2"
		if isOOB {
			hx-swap-oob="true"
		}
	>
		<div class="flex items-center justify-between mb-4">
			<h2 class="text-xl md:text-3xl"><span class="font-thin capitalize">{ getGreeting(now) },</span> <span class="font-display bg-linear-to-r from-yellow-500 via-amber-500 to-purple-500 bg-clip-text text-transparent">{ username }</span></h2>
			<button
				hx-delete="/auth/logout"
				class="px-3 py-0.5 text-xs md:text-md lg:text-lg bg-red-500 capitalize cursor-pointer flex justify-center items-center rounded-sm"
			>logout</button>
		</div>
		<div class="bg-linear-to-r from-blue-500 via-purple-500 to-pink-500 h-0.5">&nbsp;</div>
	</div>
}

templ tasksCounter(tasks []db.Task, isOOB bool) {
	<div
		id="task-counter"
		class="flex justify-between items-center font-thin text-xs md:text-md lg:text-lg mb-5"
		if isOOB {
			hx-swap-oob="true"
		}
	>
		<h5>Hola!</h5>
		if len(tasks) == 1 {
			<p>
				<span class="font-semibold text-md">{ strconv.Itoa(len(tasks)) }</span> task need to be done
			</p>
		} else if len(tasks) > 0 {
			<p>
				<span class="font-semibold text-md">{ strconv.Itoa(len(tasks)) }</span> tasks need to be done
			</p>
		} else {
			<p class="capitalize">
				create a task now.. 
			</p>
		}
	</div>
}

templ createTaskForm(form *taskForm, isOOB bool) {
	<div
		id="create-form-wrapper"
		class="mb-11 lg:mb-24"
		if isOOB {
			hx-swap-oob="true"
		}
	>
		<form
			hx-post="/task"
			hx-target="#create-form-wrapper"
			hx-swap="outerHTML"
			hx-on::after-request="if(event.detail.successful) this.reset()"
		>
			<div class="flex flex-col gap-2">
				<input
					type="text"
					class="bg-gray-400 text-gray-950 w-full rounded-tr-sm rounded-tl-sm  pl-4 md:p-1 outline-0 focus:outline-0 border-b-4 border-b-transparent focus:border-lime-600 transition-all 3s"
					placeholder="Go to gym..."
					id="title"
					name="title"
				/>
				if msg := form.Errors["title"]; msg != "" {
					<p class="text-xs text-red-500">{ msg }</p>
				}
				<button
					class="px-3 py-0.5 md:text-md lg:text-lg bg-linear-to-r from-blue-500 via-purple-500 to-pink-500 capitalize cursor-pointer flex justify-center items-center rounded-sm"
				>add</button>
			</div>
		</form>
	</div>
}

templ tasksList(tasks []db.Task, isOOB bool) {
	<ul
		id="tasks-list"
		class="flex flex-col gap-6"
		if isOOB {
			hx-swap-oob="true"
		}
	>
		for i, task := range tasks {
			<div class="flex flex-col">
				@tasksListItem(i, task)
			</div>
		}
	</ul>
}

templ tasksListItem(index int, task db.Task) {
	<li
		class="flex flex-col p-6 bg-olive-800 rounded-tl-3xl rounded-br-3xl shadow-xs"
		x-data={ fmt.Sprintf("{is_done:%t}", task.IsDone.Bool) }
		hx-patch={ fmt.Sprintf("/task/%v/toggle", task.ID) }
		hx-target="#tasks-list"
		hx-swap="outerHTML"
	>
		<span class="text-xs text-gray-400 mb-6">
			{ task.CreatedAt.Time.Format("Jan 02, 2006 15:04") }
		</span>
		<div class="flex items-center justify-center mb-6 h-7 w-7 rounded-full border border-sky-500">
			<span x-show="is_done">&check;</span>
			<span x-show="!is_done">{ index + 1 }</span>
		</div>
		<span class="mb-4 text-xl font-semibold" :class="is_done ? 'line-through text-teal-500':'' ">{ task.Title }</span>
		<button
			@click.stop
			hx-delete={ fmt.Sprintf("/task/%d", task.ID) }
			hx-target="closest li"
			hx-swap="outerHTML"
			class="self-start py-0.5 px-3 bg-pink-500 text-pink text-sm capitalize rounded-sm"
		>remove</button>
	</li>
}
