package shared

templ Base(csrfToken string, contents templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Document</title>
		</head>
		<body hx-headers={ "{ \"X-CSRF-Token\": \"" + csrfToken + "\" }" }>
			<header></header>
			<main>
				@contents
			</main>
			<footer></footer>
		</body>
	</html>
}
